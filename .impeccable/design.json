  "components": [
    {
      "name": "Welcome action",
      "kind": "button",
      "refersTo": "welcome-action",
      "description": "Canonical first-folder link on the dark desktop.",
      "html": "<a class=\"ds-welcome\" href=\"/concepts/input-output\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg>Explore the concepts</a>",
      "css": ".ds-welcome{font-family:Geist,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:12px;background:#eef6ff;color:#123a65;padding:10px 18px;min-height:44px;border-radius:5px;box-shadow:0 4px 14px rgb(2 19 48 / .14);font-size:13px;font-weight:550;text-decoration:none}.ds-welcome:hover{background:#d9eaff}.ds-welcome:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}"
    },
    {
      "name": "Selected category",
      "kind": "nav",
      "refersTo": "sidebar-link-selected",
      "description": "Category anchor with a leading blue active mark.",
      "html": "<a class=\"ds-sidebar\" href=\"/concepts/input-output\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg><span>Input/Output</span><small>5</small></a>",
      "css": ".ds-sidebar{font-family:Geist,'Segoe UI',sans-serif;position:relative;display:flex;align-items:center;gap:10px;min-height:40px;padding:8px 10px;border-radius:4px;font-size:12px;color:var(--ink,#202a35);background:#dce7f5;text-decoration:none;max-width:185px}.ds-sidebar::before{content:\"\";position:absolute;width:3px;height:16px;background:var(--blue,#0067c0);border-radius:2px;left:0;top:50%;transform:translateY(-50%)}.ds-sidebar svg{color:#867031;width:17px;height:17px}.ds-sidebar small{margin-left:auto;color:var(--muted,#526170);font-size:10px}.ds-sidebar:hover{background:#e2e8f1}.ds-sidebar:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}@media(max-width:720px){.ds-sidebar{min-height:44px;font-size:11px;padding:8px}.ds-sidebar small{display:none}}"
    },
    {
      "name": "Selected example",
      "kind": "nav",
      "refersTo": "example-row-selected",
      "description": "One of five canonical links with honest implementation status.",
      "html": "<a class=\"ds-example\" href=\"/concepts/input-output/example-1\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 2H5v20h14V8Zm0 0v6h5M8 13h8m-8 4h5\"/></svg><span>Example 01<small>Not implemented yet</small></span></a>",
      "css": ".ds-example{font-family:Geist,'Segoe UI',sans-serif;display:flex;align-items:center;gap:10px;min-height:66px;padding:10px 8px;border-radius:4px;background:var(--selection,#e0edfa);color:var(--ink,#202a35);text-decoration:none;font-size:12px;max-width:215px}.ds-example svg{width:28px;height:34px;stroke:#7a93b2;stroke-width:1.2}.ds-example small{display:block;color:var(--muted,#526170);font-size:10px;margin-top:3px}.ds-example:hover{background:var(--surface,#f3f5f8)}.ds-example:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}"
    },
    {
      "name": "Implementation status",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Neutral state label for an empty example slot.",
      "html": "<span class=\"ds-status\"><span></span>Not implemented yet</span>",
      "css": ".ds-status{font-family:Geist,'Segoe UI',sans-serif;display:inline-flex;align-items:center;gap:6px;padding:4px 8px;font-size:10px;background:#edf1f6;border-radius:4px;color:#47596e}.ds-status>span{width:5px;height:5px;background:#6d7f94;border-radius:50%}"
    },
    {
      "name": "Empty interface",
      "kind": "card",
      "refersTo": "empty-interface",
      "description": "Reserved region for future inputs and controls.",
      "html": "<div class=\"ds-empty\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg><p>Your inputs and controls will go here.</p></div>",
      "css": ".ds-empty{font-family:Geist,'Segoe UI',sans-serif;display:flex;align-items:center;gap:12px;background:var(--surface,#f3f5f8);border:1px dashed #c9d4e3;border-radius:5px;padding:16px}.ds-empty svg{color:#5b7392}.ds-empty p{font-size:12px;color:var(--muted,#526170);line-height:1.8;margin:0;max-width:55ch}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Labeled concept search with blue lower border and keyboard focus.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" aria-label=\"Search concept names and descriptions\" placeholder=\"Search your concepts\" /></label>",
      "css": ".ds-search{font-family:Geist,'Segoe UI',sans-serif;display:flex;align-items:center;gap:12px;background:var(--paper,#fcfdff);border:1px solid #b8c6d8;border-bottom:2px solid var(--blue,#0067c0);border-radius:5px;padding:10px 14px}.ds-search input{font:inherit;flex:1;width:100%;min-width:0;padding:3px 0;border:0;outline:none;color:var(--ink,#202a35);background:transparent;caret-color:var(--blue,#0067c0)}.ds-search:focus-within{outline:2px solid var(--focus,#0067c0);outline-offset:2px}.ds-search input::placeholder{color:var(--muted,#526170)}.ds-search svg{color:var(--muted,#526170);width:18px;height:18px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}"
    },
    {
      "name": "Desktop folder",
      "kind": "nav",
      "refersTo": "desktop-folder",
      "description": "Warm yellow local vector silhouette and readable category anchor.",
      "html": "<div class=\"ds-ground\"><a class=\"ds-folder\" href=\"/concepts/input-output\"><span class=\"ds-art\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"112\" height=\"92\" viewBox=\"0 0 112 92\"><!-- Shared yellow folder silhouette, with a paper insert and a warmer front. --><defs><linearGradient id=\"folder-back\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffe6a0\"/><stop offset=\"1\" stop-color=\"#e7ae39\"/></linearGradient><linearGradient id=\"folder-front\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffda79\"/><stop offset=\"1\" stop-color=\"#efb63f\"/></linearGradient></defs><path d=\"M7 20a6 6 0 0 1 6-6h27l9 9h49a6 6 0 0 1 6 6v48a6 6 0 0 1-6 6H13a6 6 0 0 1-6-6Z\" fill=\"url(#folder-back)\"/><path d=\"M14 28h83v42H14Z\" fill=\"#fff6db\"/><path d=\"M7 36a5 5 0 0 1 5-5h88a5 5 0 0 1 5 5l-4 42a6 6 0 0 1-6 5H17a6 6 0 0 1-6-5Z\" fill=\"url(#folder-front)\"/><path d=\"M13 33h86\" stroke=\"#ffe7ab\" stroke-width=\"2\"/></svg>\r\n</span><span>Input/Output</span><small>5 examples</small></a></div>",
      "css": ".ds-ground{padding:12px;background:#061a45;width:fit-content}.ds-folder{font-family:Geist,'Segoe UI',sans-serif;display:flex;flex-direction:column;align-items:center;width:108px;padding:10px 3px 8px;border:1px solid transparent;border-radius:4px;color:var(--desktop-text,#f5f8ff);text-align:center;text-shadow:0 1px 3px #04142c;text-decoration:none;transition:background 140ms var(--ease,cubic-bezier(.16,1,.3,1));font-size:12px;font-weight:450;line-height:1.5}.ds-art{display:block;width:64px;height:56px;margin-bottom:5px}.ds-art svg{width:100%;height:100%}.ds-folder small{font-size:10px;color:#e0ebff;font-weight:400}.ds-folder:hover{background:rgb(198 225 255 / .15);border-color:rgb(211 234 255 / .2)}.ds-folder:focus-visible{outline:2px solid #d6eaff;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-folder{transition:none}}"
    },
    {
      "name": "Taskbar shortcut",
      "kind": "nav",
      "refersTo": "taskbar",
      "description": "Persistent pale desktop chrome with active indicator and tooltip.",
      "html": "<nav class=\"ds-taskbar\" aria-label=\"Desktop shortcuts\"><a class=\"ds-app\" href=\"/concepts/input-output\" aria-label=\"Input/Output\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg><span class=\"ds-tooltip\">Input/Output</span><span class=\"ds-indicator\"></span></a></nav>",
      "css": ".ds-taskbar{font-family:Geist,'Segoe UI',sans-serif;display:flex;justify-content:center;align-items:center;height:58px;padding:4px 18px;background:rgb(234 241 252 / .94);backdrop-filter:blur(24px);border-top:1px solid rgb(244 249 255 / .5)}.ds-app{position:relative;display:flex;align-items:center;justify-content:center;width:44px;height:46px;border-radius:4px;color:#116ca7;text-decoration:none;background:rgb(252 253 255 / .66)}.ds-app:hover{background:rgb(252 253 255 / .66)}.ds-app svg{width:27px;height:27px;stroke-width:1.8}.ds-indicator{position:absolute;bottom:1px;height:3px;width:17px;background:var(--blue,#0067c0);border-radius:2px}.ds-tooltip{position:absolute;bottom:57px;left:50%;transform:translateX(-50%);background:var(--paper,#fcfdff);box-shadow:0 5px 20px rgb(15 40 73 / .18);padding:5px 10px;border-radius:4px;color:var(--ink,#202a35);font-size:12px;white-space:nowrap;opacity:0;visibility:hidden;pointer-events:none}.ds-app:hover .ds-tooltip,.ds-app:focus-visible .ds-tooltip{opacity:1;visibility:visible}.ds-app:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}"
    },
    {
      "name": "Native Start navigation",
      "kind": "nav",
      "refersTo": "start-panel",
      "description": "Native disclosure with canonical pinned collection links.",
      "html": "<details class=\"ds-start\"><summary aria-label=\"Open Start menu\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 3h8v8H3Zm10 0h8v8h-8ZM3 13h8v8H3Zm10 0h8v8h-8Z\"/></svg></summary><nav aria-label=\"Pinned concepts\"><h2>C# Programming Showcase</h2><h3>Pinned</h3><div class=\"ds-pinned\"><a href=\"/concepts/input-output\"><span class=\"ds-start-folder\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"112\" height=\"92\" viewBox=\"0 0 112 92\"><!-- Shared yellow folder silhouette, with a paper insert and a warmer front. --><defs><linearGradient id=\"folder-back\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffe6a0\"/><stop offset=\"1\" stop-color=\"#e7ae39\"/></linearGradient><linearGradient id=\"folder-front\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffda79\"/><stop offset=\"1\" stop-color=\"#efb63f\"/></linearGradient></defs><path d=\"M7 20a6 6 0 0 1 6-6h27l9 9h49a6 6 0 0 1 6 6v48a6 6 0 0 1-6 6H13a6 6 0 0 1-6-6Z\" fill=\"url(#folder-back)\"/><path d=\"M14 28h83v42H14Z\" fill=\"#fff6db\"/><path d=\"M7 36a5 5 0 0 1 5-5h88a5 5 0 0 1 5 5l-4 42a6 6 0 0 1-6 5H17a6 6 0 0 1-6-5Z\" fill=\"url(#folder-front)\"/><path d=\"M13 33h86\" stroke=\"#ffe7ab\" stroke-width=\"2\"/></svg>\r\n</span><span>Input/Output</span></a><a href=\"/concepts/nested-if-else\"><span class=\"ds-start-folder\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"112\" height=\"92\" viewBox=\"0 0 112 92\"><!-- Shared yellow folder silhouette, with a paper insert and a warmer front. --><defs><linearGradient id=\"folder-back\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffe6a0\"/><stop offset=\"1\" stop-color=\"#e7ae39\"/></linearGradient><linearGradient id=\"folder-front\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffda79\"/><stop offset=\"1\" stop-color=\"#efb63f\"/></linearGradient></defs><path d=\"M7 20a6 6 0 0 1 6-6h27l9 9h49a6 6 0 0 1 6 6v48a6 6 0 0 1-6 6H13a6 6 0 0 1-6-6Z\" fill=\"url(#folder-back)\"/><path d=\"M14 28h83v42H14Z\" fill=\"#fff6db\"/><path d=\"M7 36a5 5 0 0 1 5-5h88a5 5 0 0 1 5 5l-4 42a6 6 0 0 1-6 5H17a6 6 0 0 1-6-5Z\" fill=\"url(#folder-front)\"/><path d=\"M13 33h86\" stroke=\"#ffe7ab\" stroke-width=\"2\"/></svg>\r\n</span><span>Nested If…Else</span></a><a href=\"/concepts/loops\"><span class=\"ds-start-folder\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"112\" height=\"92\" viewBox=\"0 0 112 92\"><!-- Shared yellow folder silhouette, with a paper insert and a warmer front. --><defs><linearGradient id=\"folder-back\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffe6a0\"/><stop offset=\"1\" stop-color=\"#e7ae39\"/></linearGradient><linearGradient id=\"folder-front\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffda79\"/><stop offset=\"1\" stop-color=\"#efb63f\"/></linearGradient></defs><path d=\"M7 20a6 6 0 0 1 6-6h27l9 9h49a6 6 0 0 1 6 6v48a6 6 0 0 1-6 6H13a6 6 0 0 1-6-6Z\" fill=\"url(#folder-back)\"/><path d=\"M14 28h83v42H14Z\" fill=\"#fff6db\"/><path d=\"M7 36a5 5 0 0 1 5-5h88a5 5 0 0 1 5 5l-4 42a6 6 0 0 1-6 5H17a6 6 0 0 1-6-5Z\" fill=\"url(#folder-front)\"/><path d=\"M13 33h86\" stroke=\"#ffe7ab\" stroke-width=\"2\"/></svg>\r\n</span><span>Loops</span></a><a href=\"/concepts/arrays\"><span class=\"ds-start-folder\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"112\" height=\"92\" viewBox=\"0 0 112 92\"><!-- Shared yellow folder silhouette, with a paper insert and a warmer front. --><defs><linearGradient id=\"folder-back\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffe6a0\"/><stop offset=\"1\" stop-color=\"#e7ae39\"/></linearGradient><linearGradient id=\"folder-front\" x2=\"0\" y2=\"1\"><stop stop-color=\"#ffda79\"/><stop offset=\"1\" stop-color=\"#efb63f\"/></linearGradient></defs><path d=\"M7 20a6 6 0 0 1 6-6h27l9 9h49a6 6 0 0 1 6 6v48a6 6 0 0 1-6 6H13a6 6 0 0 1-6-6Z\" fill=\"url(#folder-back)\"/><path d=\"M14 28h83v42H14Z\" fill=\"#fff6db\"/><path d=\"M7 36a5 5 0 0 1 5-5h88a5 5 0 0 1 5 5l-4 42a6 6 0 0 1-6 5H17a6 6 0 0 1-6-5Z\" fill=\"url(#folder-front)\"/><path d=\"M13 33h86\" stroke=\"#ffe7ab\" stroke-width=\"2\"/></svg>\r\n</span><span>Arrays</span></a></div><a class=\"ds-about\" href=\"/about\">Read me</a></nav></details>",
      "css": ".ds-start{font-family:Geist,'Segoe UI',sans-serif;color:var(--ink,#202a35)}.ds-start summary{cursor:pointer;min-height:44px;display:flex;align-items:center;justify-content:center;width:44px;border-radius:4px;color:#0872ce}.ds-start summary:hover,.ds-start[open] summary{background:rgb(252 253 255 / .66)}.ds-start nav{background:#eef3fb;border-radius:8px;padding:30px 34px;box-shadow:var(--window-shadow,0 20px 70px -14px rgb(3 17 43 / .48));max-width:580px}.ds-start h2{margin:0 0 20px;font-size:18px;font-weight:600}.ds-start h3{font-size:13px;font-weight:600;margin:24px 0 12px}.ds-pinned{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}.ds-start a{display:flex;align-items:center;justify-content:center;text-align:center;border-radius:5px;padding:12px 2px;font-size:12px;color:inherit;text-decoration:none;min-height:44px}.ds-start a:hover{background:#e0e9f7}.ds-start summary:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}.ds-start a:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}.ds-about{margin-top:26px}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}@media(max-width:720px){.ds-pinned{grid-template-columns:repeat(2,minmax(0,1fr))}.ds-start nav{padding:22px 20px}}.ds-pinned a{flex-direction:column;gap:10px}.ds-start-folder{display:block;width:48px;height:42px}.ds-start-folder svg{width:100%;height:100%;stroke:none}"
    },
    {
      "name": "Explorer shell",
      "kind": "custom",
      "refersTo": "explorer-window",
      "description": "Light single-tab workspace with right caption controls and status.",
      "html": "<section class=\"ds-window\" aria-labelledby=\"ds-title\"><header class=\"ds-toolbar\"><div class=\"ds-tab\"><h2 id=\"ds-title\">Input/Output</h2></div><div class=\"ds-caption\"><button aria-label=\"Minimize window\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"/></svg></button><button aria-label=\"Maximize window\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"5\" y=\"5\" width=\"14\" height=\"14\"/></svg></button><a href=\"/\" aria-label=\"Close window\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></a></div></header><div class=\"ds-detail\"><h3>Input/Output</h3><p>Read input, work with values, and display output.</p></div><footer>Concepts / Input/Output <span>5 items</span></footer></section>",
      "css": ".ds-window{font-family:Geist,'Segoe UI',sans-serif;display:flex;flex-direction:column;overflow:hidden;width:min(560px,100%);background:var(--paper,#fcfdff);color:var(--ink,#202a35);border-radius:var(--radius-window,8px);box-shadow:var(--window-shadow,0 20px 70px -14px rgb(3 17 43 / .48))}.ds-toolbar{display:flex;justify-content:space-between;align-items:flex-end;min-height:44px;background:#e6edf7;padding-left:10px}.ds-tab{background:var(--surface,#f3f5f8);border-radius:7px 7px 0 0;min-height:36px;width:240px;padding:7px 14px}.ds-tab h2{font-size:12px;font-weight:450;line-height:1.5;margin:0}.ds-caption{display:flex;align-self:stretch}.ds-caption>*{display:grid;place-items:center;width:46px;min-height:44px;background:transparent;border:0;color:inherit;text-decoration:none;cursor:pointer}.ds-caption>*:hover{background:#d5dfed}.ds-caption>a:hover{background:#c42b36;color:#fff4f5}.ds-caption>*:focus-visible{outline:2px solid var(--focus,#0067c0);outline-offset:3px}.ds-caption svg{width:15px;height:15px;stroke-width:1.3}.ds-detail{padding:34px 36px}.ds-detail h3{font-size:clamp(26px,2.5vw,34px);font-weight:550;line-height:1.25;letter-spacing:-.025em;margin:0 0 12px}.ds-detail p{color:var(--muted,#526170);line-height:1.85;max-width:42ch;font-size:13px;margin:0}.ds-window footer{display:flex;justify-content:space-between;min-height:30px;padding:5px 18px;border-top:1px solid var(--line,#dde3eb);font-size:10px;color:var(--muted,#526170)}svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}"
    }
  ],
  "narrative": {
    "northStar": "A desktop for curious minds.",
    "overview": "The approved Windows 11 inspired world pairs an original cobalt bloom wallpaper with warm yellow folder silhouettes, a full-width translucent taskbar and a light Explorer workspace. Desktop familiarity invites exploration; compact application typography keeps the examples easy to navigate.\n\nThe Windows direction is deliberate on `windows-design`; `main` retains the earlier macOS version. The user-approved metaphor and existing MVC implementation govern this system. Surface composition and visitor modes live in docs/design-brief.md.",
    "keyCharacteristics": [
      "Dark cobalt raster bloom with readable light desktop text.",
      "Yellow folders, a centered taskbar app group and a left-aligned welcome.",
      "One light Explorer workspace with a tab, right caption controls and clear blue selection.",
      "Local Geist typography, canonical links and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Readable Desktop Rule",
        "body": "Check light labels against the wallpaper beneath them; an average image color cannot establish text contrast.",
        "section": "colors"
      },
      {
        "name": "The Two Registers Rule",
        "body": "Keep expressive welcome and About headings separate from compact application navigation and example detail.",
        "section": "typography"
      },
      {
        "name": "The Persistent Taskbar Rule",
        "body": "Maximized Explorer fills the viewport above the taskbar; the taskbar remains visible and never covers window detail or status content.",
        "section": "layout"
      },
      {
        "name": "The Material Boundary Rule",
        "body": "Keep translucency on desktop chrome and preserve solid reading surfaces inside Explorer, Start and search.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** read PRODUCT.md, DESIGN.md and the project showcase-ui skill before changing the interface.",
      "**Do** preserve the approved Windows desktop materials and shared Explorer template on this branch.",
      "**Do** keep canonical navigation, visible focus and the exact-example minimize/restore behavior.",
      "**Do** check desktop, narrow phone, short landscape, keyboard and reduced-motion behavior after UI changes."
    ],
    "donts": [
      "**Don't** import React or introduce a frontend build pipeline into this MVC template.",
      "**Don't** replace the authored bloom with CSS sculpture or use purchased operating-system assets.",
      "**Don't** cover the persistent taskbar when maximizing Explorer.",
      "**Don't** replace honest empty examples with invented execution or persistence.\r"
    ]
  }
}
