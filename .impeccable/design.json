      "refersTo": "finder-window",
      "description": "Opaque application surface with a precise toolbar and status bar.",
      "html": "<section class=\"ds-window\" aria-labelledby=\"ds-title\"><header class=\"ds-toolbar\"><h2 id=\"ds-title\">Input/Output</h2><span>5 examples</span></header><div class=\"ds-detail\"><h3>Input/Output</h3><p>Read input, work with values, and display output.</p></div><footer class=\"ds-footer\"><span>Concepts / Input/Output</span><span>5 items</span></footer></section>",
      "css": ".ds-window{font-family:var(--font,Geist,'Segoe UI',sans-serif);display:flex;flex-direction:column;background:var(--paper,#f8fafc);color:var(--ink,#24354a);border-radius:var(--radius,14px);box-shadow:var(--shadow,0 24px 80px -16px rgb(3 22 49 / .5)),inset 0 0 0 1px rgb(227 236 247 / .65);overflow:hidden;width:min(520px,100%)}.ds-toolbar{display:flex;align-items:center;gap:16px;height:58px;padding:0 20px;background:linear-gradient(#f3f6fa,#e9eef5);box-shadow:0 1px 0 #d7e0ea}.ds-toolbar h2{margin:0;font-size:14px;font-weight:650;letter-spacing:-.02em}.ds-toolbar>span{margin-left:auto;font-size:11px;color:var(--muted,#566b83)}.ds-detail{padding:29px 34px}.ds-detail h3{margin:0 0 13px;font-size:30px;font-weight:600;line-height:1.3;letter-spacing:-.035em}.ds-detail p{margin:0;font-size:13px;color:var(--muted,#566b83);max-width:36ch;line-height:1.85}.ds-footer{display:flex;align-items:center;justify-content:space-between;height:32px;padding:0 18px;background:#f0f4f9;border-top:1px solid #e0e7ef;font-size:10px;color:var(--muted,#566b83)}"
    },
    {
      "name": "Glass dock shortcut",
      "kind": "nav",
      "refersTo": "dock",
      "description": "Cyan category tile with active dot and keyboard/hover tooltip.",
      "html": "<nav class=\"ds-dock\" aria-label=\"Desktop shortcuts\"><a class=\"ds-dock-item\" href=\"/concepts/input-output\" aria-label=\"Input/Output\" aria-current=\"page\"><span class=\"ds-tile\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg></span><span class=\"ds-tooltip\">Input/Output</span><span class=\"ds-indicator\"></span></a></nav>",
      "css": ".ds-dock{font-family:var(--font,Geist,'Segoe UI',sans-serif);display:inline-flex;align-items:center;gap:10px;height:83px;padding:10px 13px 15px;background:rgb(209 227 247 / .23);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:inset 0 1px 0 rgb(235 247 255 / .35),0 10px 30px rgb(3 21 43 / .25);border-radius:20px}.ds-dock-item{position:relative;display:flex;align-items:center;justify-content:center;width:54px;height:56px;text-decoration:none}.ds-tile{width:52px;height:52px;border-radius:13px;display:grid;place-items:center;box-shadow:inset 0 1px 0 rgb(240 249 255 / .5),0 3px 5px rgb(4 31 62 / .22);transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1));color:#f2f8ff;background:linear-gradient(155deg,#5dcaea,#1686ba)}.ds-tile .ds-icon{width:29px;height:29px;stroke-width:1.6}.ds-dock-item:hover .ds-tile,.ds-dock-item:focus-visible .ds-tile{transform:translateY(-9px) scale(1.08)}.ds-tooltip{position:absolute;bottom:76px;background:rgb(236 243 251 / .96);color:#24354a;border-radius:6px;padding:5px 10px;white-space:nowrap;font-size:11px;box-shadow:0 4px 12px rgb(8 27 49 / .2);opacity:0;pointer-events:none;transform:translateY(5px);transition:opacity .18s var(--ease,cubic-bezier(.16,1,.3,1)),transform .18s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-dock-item:hover .ds-tooltip,.ds-dock-item:focus-visible .ds-tooltip{opacity:1;transform:translateY(0)}.ds-indicator{position:absolute;bottom:-9px;width:4px;height:4px;border-radius:50%;background:#e9f4ff}.ds-dock-item:focus-visible{outline-color:#d2eaff;border-radius:13px}.ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-link:focus-visible,.ds-plain:focus-visible,.ds-search:focus-visible,.ds-sidebar:focus-visible,.ds-row:focus-visible,.ds-dock-item:focus-visible,.ds-folder:focus-visible{outline:3px solid #1979df;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-tile,.ds-tooltip{transition:none}.ds-dock-item:hover .ds-tile,.ds-dock-item:focus-visible .ds-tile{transform:none}}.ds-dock-item:focus-visible{outline-color:#d2eaff}"
    },
    {
      "name": "Dimensional desktop folder",
      "kind": "custom",
      "refersTo": "desktop-folder",
      "description": "Canonical category link using the local folder silhouette and concept emblem.",
      "html": "<a class=\"ds-folder\" href=\"/concepts/input-output\"><span class=\"ds-art\"><svg class=\"ds-folder-art\" viewBox=\"0 0 112 92\" aria-hidden=\"true\"><defs><linearGradient id=\"ds-folder-back\" x2=\"0\" y2=\"1\"><stop stop-color=\"#78c9f3\"/><stop offset=\"1\" stop-color=\"#3296d4\"/></linearGradient><linearGradient id=\"ds-folder-front\" x2=\"0\" y2=\"1\"><stop stop-color=\"#96dfff\"/><stop offset=\".06\" stop-color=\"#7dd2fa\"/><stop offset=\"1\" stop-color=\"#51b3e8\"/></linearGradient></defs><path d=\"M6 17a7 7 0 0 1 7-7h27l10 8h49a7 7 0 0 1 7 7v52a7 7 0 0 1-7 7H13a7 7 0 0 1-7-7Z\" fill=\"url(#ds-folder-back)\"/><path d=\"M9 28a5 5 0 0 1 5-5h84a5 5 0 0 1 5 5v47a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5Z\" fill=\"#dbf4ff\"/><rect x=\"5\" y=\"27\" width=\"102\" height=\"58\" rx=\"6\" fill=\"url(#ds-folder-front)\" stroke=\"#2c8ac0\"/><path d=\"M11 29h90\" stroke=\"#ccf0ff\" stroke-opacity=\".65\"/><path d=\"M11 81h90\" stroke=\"#3094cc\" stroke-opacity=\".5\"/></svg><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg></span><span class=\"ds-folder-name\">Input/Output</span><span class=\"ds-folder-count\">5 examples</span></a>",
      "css": ".ds-folder{font-family:var(--font,Geist,'Segoe UI',sans-serif);display:flex;align-items:center;flex-direction:column;padding:8px 4px;border-radius:9px;transition:background .2s var(--ease,cubic-bezier(.16,1,.3,1));text-shadow:0 2px 6px rgb(3 24 48 / .5);color:var(--desktop-text,#f0f6ff);text-decoration:none;width:124px}.ds-folder:hover{background:rgb(183 221 255 / .16)}.ds-folder:focus-visible{outline-color:#c3e5ff}.ds-art{position:relative;display:block;width:88px;height:72px;filter:drop-shadow(0 5px 5px rgb(3 27 54 / .25));transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-folder-art{width:100%;height:100%}.ds-art>.ds-icon{position:absolute;left:32px;top:36px;width:24px;height:24px;stroke:#2177a9;opacity:.64;stroke-width:1.6}.ds-folder:hover .ds-art{transform:translateY(-3px)}.ds-folder-name{font-size:13px;line-height:1.5;font-weight:550;margin-top:5px}.ds-folder-count{font-size:10px;line-height:1.6;color:#d5e7fa;letter-spacing:.01em}.ds-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-link:focus-visible,.ds-plain:focus-visible,.ds-search:focus-visible,.ds-sidebar:focus-visible,.ds-row:focus-visible,.ds-dock-item:focus-visible,.ds-folder:focus-visible{outline:3px solid #1979df;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-folder,.ds-art{transition:none}.ds-folder:hover .ds-art{transform:none}}.ds-folder:focus-visible{outline-color:#c3e5ff}"
    }
  ],
  "narrative": {
    "northStar": "A desktop for curious minds.",
    "overview": "Preserve the user's reference: a photographic blue mountain desktop, dimensional blue folders, a translucent menu bar, an expressive light welcome title and a glass dock. Opening a folder reveals one precise Finder-style workspace. Familiar desktop materials provide warmth; restrained application typography provides clarity.\n\nThe user's visual reference overrides generic skill bans against centered compositions, glass and dimensional icons. MVC is the required implementation, regardless of React/Tailwind defaults in supporting skills. This file owns the shared visual decisions; surface composition and modes live in docs/design-brief.md.",
    "keyCharacteristics": [
      "Cobalt mountain photography with readable light desktop text.",
      "Dimensional blue folders and softly tinted glass chrome.",
      "One opaque, precise Finder workspace with clear blue selection.",
      "Geist typography, compact navigation and visible keyboard focus."
    ],
    "rules": [
      {
        "name": "The Readable Desktop Rule",
        "body": "Check light labels against the wallpaper beneath them; an average image color cannot establish text contrast.",
        "section": "colors"
      },
      {
        "name": "The Two Registers Rule",
        "body": "Keep expressive display typography on the desktop welcome and About headline; use the compact application ramp inside navigation and example detail.",
        "section": "typography"
      },
      {
        "name": "The Clear Workspace Rule",
        "body": "Reserve the dock's footprint before sizing the Finder; the dock must never cover detail or status content.",
        "section": "layout"
      },
      {
        "name": "The Material Boundary Rule",
        "body": "Keep glass on desktop chrome; preserve the opaque light Finder as the reading and working surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do read PRODUCT.md and this file before UI changes. Use the project skill at .agents/skills/showcase-ui/ to coordinate the installed design skills.",
      "Do preserve the reference's desktop identity and reuse shared Razor partials.",
      "Do inspect desktop, phone and short-height layouts, including keyboard and reduced-motion behavior."
    ],
    "donts": [
      "Don't import React libraries or add a frontend build pipeline to this MVC template.",
      "Don't copy the reference's personal identity, Apple logo or proprietary dock icons.",
      "Don't replace clearly unimplemented examples with invented programs."
    ]
  }
}
