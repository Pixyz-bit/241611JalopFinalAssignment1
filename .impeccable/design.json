      "html": "<nav class=\"ds-nav\" aria-label=\"Categories\"><a class=\"ds-sidebar\" href=\"/concepts/input-output\" aria-current=\"page\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"m7 9 3 3-3 3m6 0h4\"/></svg><span>Input/Output</span><small>5</small></a></nav>",
