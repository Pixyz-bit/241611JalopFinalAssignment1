      "kind": "button",
      "refersTo": "primary-link",
      "description": "Canonical link from a category overview into its first example.",
      "html": "<a class=\"ds-link\" href=\"/concepts/input-output/example-1\">Open Example 01 <svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a>",
