@model TemperatureConverterViewModel
@{
    // Unit symbols keep the confirmed conversion compact and readable.
    var fromSymbol = Model.FromUnit switch { TemperatureUnit.Celsius => "°C", TemperatureUnit.Fahrenheit => "°F", _ => "K" };
    var toSymbol = Model.ToUnit switch { TemperatureUnit.Celsius => "°C", TemperatureUnit.Fahrenheit => "°F", _ => "K" };
}
<div class="example-workspace example-split temperature-example">
    <div class="example-heading"><h4>@ExampleCatalog.GetTitle("input-output", 3)</h4></div>
    @* Native POST handles calculations; JavaScript only enhances Swap, Clear and stale feedback. *@
    <form asp-controller="Concepts" asp-action="ConvertTemperature" method="post" class="example-form example-layout temperature-form"
          data-confirmed-result="@(Model.Result?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
        <section class="example-panel example-input-panel" aria-labelledby="temperature-input-title">
            <h5 id="temperature-input-title">Input</h5>
            <div class="example-input-fields">
                <div>
                    <label asp-for="Value">Amount</label>
                    <input asp-for="Value" type="number" step="any" placeholder="0" class="example-input" aria-describedby="temperature-help temperature-error" />
                    <span asp-validation-for="Value" id="temperature-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="FromUnit">From</label>
                    <select asp-for="FromUnit" class="example-input" aria-describedby="temperature-from-error">
                        <option value="Celsius">Celsius (°C)</option><option value="Fahrenheit">Fahrenheit (°F)</option><option value="Kelvin">Kelvin (K)</option>
                    </select>
                    <span asp-validation-for="FromUnit" id="temperature-from-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="ToUnit">To</label>
                    <select asp-for="ToUnit" class="example-input" aria-describedby="temperature-to-error">
                        <option value="Celsius">Celsius (°C)</option><option value="Fahrenheit">Fahrenheit (°F)</option><option value="Kelvin">Kelvin (K)</option>
                    </select>
                    <span asp-validation-for="ToUnit" id="temperature-to-error" class="temperature-errors"></span>
                </div>
            </div>
            <div class="temperature-actions">
                <button type="submit" class="temperature-confirm">Confirm</button>
                <a href="/concepts/input-output/example-3" class="temperature-clear" data-temperature-clear>Clear</a>
                <button type="button" class="temperature-clear temperature-swap" data-temperature-swap>Swap units</button>
                <noscript><button type="submit" name="command" value="swap" class="temperature-clear">Swap units</button></noscript>
            </div>
            <p id="temperature-help" class="sr-only">Choose Confirm to update the result.</p>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="temperature-result-title">
            <h5 id="temperature-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <partial name="_ExampleEmpty" model="Model.Result.HasValue" />
                <div class="example-result-content" data-example-result hidden="@(!Model.Result.HasValue)">
                    <span class="example-result-label">Converted temperature</span>
                    <strong class="example-result-value">@Model.Value?.ToString("0.##") @fromSymbol → @Model.Result?.ToString("0.##") @toSymbol</strong>
                    <p class="example-result-formula example-result-label">Formula: @Model.Formula</p>
                </div>
            </div>
            <p class="example-result-note">Up to 2 decimal places.</p>
        </section>
    </form>
</div>
