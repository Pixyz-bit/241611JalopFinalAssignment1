@model TemperatureConverterViewModel

<div class="example-workspace temperature-example">
    <div class="example-heading"><h4>Temperature Converter</h4></div>
    <p class="detail-description">Convert between Celsius, Fahrenheit and Kelvin.</p>

    @* A normal MVC form keeps validation and calculations available without JavaScript. *@
    <form asp-controller="Concepts" asp-action="ConvertTemperature" method="post" class="temperature-form">
        <div class="temperature-pair">
            <div class="temperature-field">
                <label asp-for="Value" class="temperature-field-label">From</label>
                <div class="temperature-panel">
                    <input asp-for="Value" type="number" step="any" placeholder="0"
                           class="temperature-value" aria-describedby="temperature-help temperature-error" />
                    <label asp-for="FromUnit" class="sr-only">From unit</label>
                    <select asp-for="FromUnit" class="temperature-unit">
                        <option value="Celsius">Celsius (°C)</option>
                        <option value="Fahrenheit">Fahrenheit (°F)</option>
                        <option value="Kelvin">Kelvin (K)</option>
                    </select>
                </div>
                <span asp-validation-for="Value" id="temperature-error" class="temperature-errors"></span>
                <span asp-validation-for="FromUnit" class="temperature-errors"></span>
            </div>
            <span class="temperature-equals" aria-hidden="true">=</span>
            <div class="temperature-field">
                @* The confirmed output is readonly and excluded from the controller's input binding. *@
                <label for="temperature-result" class="temperature-field-label">To</label>
                <div class="temperature-panel">
                    <input id="temperature-result" type="text" readonly class="temperature-value"
                           value="@(Model.Result?.ToString("0.##"))" placeholder="—" />
                    <label asp-for="ToUnit" class="sr-only">To unit</label>
                    <select asp-for="ToUnit" class="temperature-unit">
                        <option value="Celsius">Celsius (°C)</option>
                        <option value="Fahrenheit">Fahrenheit (°F)</option>
                        <option value="Kelvin">Kelvin (K)</option>
                    </select>
                </div>
                <span asp-validation-for="ToUnit" class="temperature-errors"></span>
            </div>
        </div>
        <p id="temperature-help" class="temperature-help">Choose Confirm to update the result.</p>
        <button type="submit" class="temperature-confirm">Confirm</button>
    </form>

    <div class="temperature-formula" aria-live="polite">
        <span class="temperature-formula-label">Formula</span>
        <span>@(Model.Formula ?? "Your calculation will appear here after confirmation.")</span>
    </div>
</div>
