@model JALOPARLANMARTIN_241611_TimeConverterViewModel
@{
    // Keep the converted value readable, with grouping and no unnecessary decimal zeros.
    var resultText = Model.Result?.ToString("N8").TrimEnd('0').TrimEnd(System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator.ToCharArray());
}
@* The shared form contains both panels, so native POST works without JavaScript. *@
<div class="example-workspace example-split">
    <div class="example-heading"><h4>@JALOPARLANMARTIN_241611_ExampleCatalog.GetTitle("input-output", 4)</h4></div>
    <form asp-controller="JALOPARLANMARTIN_241611_InputOutput" asp-action="ConvertTime" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="time-input-title">
            <h5 id="time-input-title">Input</h5>
            <div class="example-input-fields">
                <div>
                    <label asp-for="Value">Amount</label>
                    <input asp-for="Value" type="number" step="any" class="example-input" placeholder="For example, 3" aria-describedby="time-error" />
                    <span asp-validation-for="Value" id="time-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="FromUnit">From</label>
                    <select asp-for="FromUnit" asp-items="Html.GetEnumSelectList<JALOPARLANMARTIN_241611_TimeUnit>()" class="example-input" aria-describedby="time-from-error"></select>
                    <span asp-validation-for="FromUnit" id="time-from-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="ToUnit">To</label>
                    <select asp-for="ToUnit" asp-items="Html.GetEnumSelectList<JALOPARLANMARTIN_241611_TimeUnit>()" class="example-input" aria-describedby="time-to-error"></select>
                    <span asp-validation-for="ToUnit" id="time-to-error" class="temperature-errors"></span>
                </div>
            </div>
            <div class="temperature-actions"><button class="temperature-confirm" type="submit">Convert</button><a class="temperature-clear" href="/concepts/input-output/example-4">Clear</a></div>
        </section>
        @* Keep this panel visible in empty, invalid and successful states to preserve the layout. *@
        <section class="example-panel example-output-panel" aria-labelledby="example-result-content-title">
            <h5 id="example-result-content-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <partial name="JALOPARLANMARTIN_241611_ExampleEmpty" model="Model.Result.HasValue" />
                <div class="example-result-content" data-example-result hidden="@(!Model.Result.HasValue)">
                    <span class="example-result-label">Converted time</span>
                    @* Emphasize the complete conversion; the arrow shows its direction. *@
                    <strong class="example-result-value">@Model.Value?.ToString("0.########") @Model.FromUnit.ToString().ToLowerInvariant() → @resultText @Model.ToUnit.ToString().ToLowerInvariant()</strong>
                    @* Reuse the label typography so the formula supports the larger conversion. *@
                    <p class="example-result-formula example-result-label">Formula: @Model.Formula</p>
                </div>
            </div>
            <p class="example-result-note">Up to 8 decimal places.</p>
        </section>
    </form>
</div>
