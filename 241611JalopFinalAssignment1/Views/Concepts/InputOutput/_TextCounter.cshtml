@model TextCounterViewModel
<div class="example-workspace example-split">
    <div class="example-heading"><h4>@ExampleCatalog.GetTitle("input-output", 5)</h4></div>
    @* A single native form keeps inputs first and the persistent result panel second. *@
    <form asp-controller="InputOutput" asp-action="CountText" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="counter-input-title">
            <h5 id="counter-input-title">Input</h5>
            <label asp-for="Text">Your text</label>
            <textarea asp-for="Text" rows="6" maxlength="10000" class="example-input example-textarea" aria-describedby="text-error" placeholder="Type or paste your paragraph here…"></textarea>
            <span asp-validation-for="Text" id="text-error" class="temperature-errors"></span>
            <div class="temperature-actions"><button type="submit" class="temperature-confirm">Count</button><a href="/concepts/input-output/example-5" class="temperature-clear">Clear</a></div>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="counter-result-title">
            <h5 id="counter-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <partial name="_ExampleEmpty" model="Model.HasResult" />
                @* Encode all entered text through Razor; never render it with Html.Raw. *@
                <div class="example-result" data-example-result hidden="@(!Model.HasResult)">
                    <div class="counter-totals"><div><span>Characters</span><strong data-character-count>@Model.Characters</strong></div><div><span>Words</span><strong data-word-count>@Model.Words</strong></div></div>
                </div>
            </div>
        </section>
    </form>
</div>
