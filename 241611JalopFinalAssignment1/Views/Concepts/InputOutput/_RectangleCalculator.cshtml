@model RectangleCalculatorViewModel
<div class="example-workspace example-split rectangle-example">
    <div class="example-heading"><h4>@ExampleCatalog.GetTitle("input-output", 2)</h4></div>
    <p class="detail-description">Calculate a rectangle’s area and perimeter. Use the same unit for both dimensions.</p>
    @* Both panels share a native form so calculations work without JavaScript. *@
    <form asp-controller="InputOutput" asp-action="CalculateRectangle" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="rectangle-input-title">
            <h5 id="rectangle-input-title">Input</h5>
            <div class="example-input-fields">
                <div>
                    <label asp-for="Length">Length</label>
                    <input asp-for="Length" class="example-input" type="number" min="0.01" max="1000000" step="any" required aria-describedby="rectangle-length-error" />
                    <span asp-validation-for="Length" id="rectangle-length-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Width">Width</label>
                    <input asp-for="Width" class="example-input" type="number" min="0.01" max="1000000" step="any" required aria-describedby="rectangle-width-error" />
                    <span asp-validation-for="Width" id="rectangle-width-error" class="temperature-errors"></span>
                </div>
            </div>
            <p class="example-hint">Enter dimensions from 0.01 to 1,000,000. Decimals are welcome.</p>
            <div class="temperature-actions"><button class="temperature-confirm" type="submit">Calculate</button><a class="temperature-clear" href="/concepts/input-output/example-2">Clear</a></div>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="rectangle-result-title">
            <h5 id="rectangle-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <partial name="_ExampleEmpty" model="Model.Area.HasValue" />
                <div class="example-result-content" data-example-result hidden="@(!Model.Area.HasValue)">
                    <span class="example-result-label">Area</span>
                    <strong class="example-result-value" data-rectangle-area>@Model.Area?.ToString("0.########") square units</strong>
                    <p class="example-result-formula example-result-label">Area = length × width</p>
                    <span class="example-result-label">Perimeter</span>
                    <strong class="example-result-value" data-rectangle-perimeter>@Model.Perimeter?.ToString("0.########") units</strong>
                    <p class="example-result-formula example-result-label">Perimeter = 2 × (length + width)</p>
                </div>
            </div>
            <p class="example-result-note">Results shown to up to 8 decimal places.</p>
        </section>
    </form>
</div>
