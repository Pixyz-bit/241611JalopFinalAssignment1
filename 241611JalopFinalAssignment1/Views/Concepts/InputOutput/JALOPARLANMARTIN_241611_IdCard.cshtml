@model JALOPARLANMARTIN_241611_IdCardViewModel
<div class="example-workspace example-split id-example">
    <div class="example-heading"><h4>@JALOPARLANMARTIN_241611_ExampleCatalog.GetTitle("input-output", 1)</h4></div>
    @* The preview and its empty state share the same form as the input panel. *@
    <form asp-controller="JALOPARLANMARTIN_241611_InputOutput" asp-action="GenerateId" method="post" class="example-form example-layout" data-example-form data-id-form>
        <section class="example-panel example-input-panel" aria-labelledby="id-input-title">
            <h5 id="id-input-title">Input</h5>
            <label asp-for="FullName">Full name</label><input asp-for="FullName" class="example-input" required maxlength="80" autocomplete="off" /><span asp-validation-for="FullName" class="temperature-errors"></span>
            <div class="example-fields">
                <div><label asp-for="StudentNumber">Student number</label><input asp-for="StudentNumber" class="example-input" required maxlength="30" autocomplete="off" /><span asp-validation-for="StudentNumber" class="temperature-errors"></span></div>
                <div><label asp-for="YearLevel">Year level</label><select asp-for="YearLevel" class="example-input" required><option value="">Select year</option>@for (var year = 1; year <= 6; year++) { <option value="@year">Year @year</option> }</select><span asp-validation-for="YearLevel" class="temperature-errors"></span></div>
            </div>
            <div class="id-course"><label asp-for="Course">Course</label><input asp-for="Course" class="example-input" required maxlength="80" autocomplete="off" /><span asp-validation-for="Course" class="temperature-errors"></span></div>
            @* No name attribute: browsers exclude the photo from FormData and native form submissions. *@
            <label for="id-photo" class="id-photo-label">Photo <span>(optional)</span></label>
            <input id="id-photo" type="file" accept="image/jpeg,image/png,image/webp" class="example-input" />
            <p data-id-photo-status class="example-hint" role="status"></p>
            <div data-id-errors class="temperature-errors" role="alert"></div>
            <div class="temperature-actions"><button type="submit" class="temperature-confirm">Generate ID</button><a href="/concepts/input-output/example-1" class="temperature-clear" data-id-clear>Clear</a></div>
            <p class="example-hint" data-example-hint role="status"></p>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="id-result-title">
            <h5 id="id-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <partial name="JALOPARLANMARTIN_241611_ExampleEmpty" model="Model.HasResult" />
                <section class="id-preview" data-example-result data-id-preview hidden="@(!Model.HasResult)" aria-label="Student ID preview">
                    <header class="id-card-header"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><span>Student ID</span></header>
                    <div class="id-card-body">
                        <div class="id-photo"><img data-id-photo-preview alt="Selected ID portrait" hidden /><span data-id-photo-placeholder>No photo</span></div>
                        @* Keyboard users can scroll unusually long details without changing the card's fixed ratio. *@
                        <div class="id-card-details" role="region" aria-label="Student details" tabindex="0">
                            @* Keep the number directly beneath the portrait; JavaScript updates only its value span. *@
                            <h6><span class="sr-only">Student number </span><span data-id-number>@Model.StudentNumber</span></h6>
                            <dl>
                                <div><dt>Full name</dt><dd data-id-name>@Model.FullName</dd></div>
                                <div><dt>Course</dt><dd data-id-course>@Model.Course</dd></div>
                                <div><dt>Year level</dt><dd data-id-year>@Model.YearLevelLabel</dd></div>
                            </dl>
                        </div>
                    </div>
                </section>
            </div>
        </section>
    </form>
</div>
