@model JALOPARLANMARTIN_241611_QuizRetryViewModel
<div class="example-workspace example-split loop-example">
    @* Reuse the model's loop type so the heading matches the code and explanation. *@
    <div class="example-heading"><h4>@Model.Title <span class="example-loop-type">(@Model.LoopKind loop)</span></h4></div>
    @* This example submits its inputs to JALOPARLANMARTIN_241611_LoopsController.RetryQuiz(). *@
    <form asp-controller="JALOPARLANMARTIN_241611_Loops" asp-action="RetryQuiz" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="loop-input-title">
            <h5 id="loop-input-title">Input</h5>
            @if (!ViewData.ModelState.IsValid)
            {
                @* Linked errors preserve the same keyboard recovery used by the decision examples. *@
                <div class="decision-errors" role="alert" tabindex="-1" data-loop-errors>
                    <h5>Check your inputs</h5>
                    <ul>
                        @foreach (var field in ViewData.ModelState)
                        {
                            @foreach (var error in field.Value.Errors) { <li><a href="@(field.Key == "StateToken" ? "#loop-reset" : $"#{field.Key}")">@error.ErrorMessage</a></li> }
                        }
                    </ul>
                </div>
            }
            @* All input controls for this example are in this file. *@
            <input asp-for="StateToken" type="hidden" />
            <span asp-validation-for="StateToken" id="round-error" class="temperature-errors"></span>
            <p id="quiz-question" class="loop-question">@Model.Question.Prompt</p>
            <label asp-for="Answer">Your answer</label>
            <select asp-for="Answer" required disabled="@Model.IsFinished" class="example-input" aria-invalid="@(ViewData.ModelState[nameof(Model.Answer)]?.Errors.Count > 0 ? "true" : null)" aria-describedby="quiz-question answer-help answer-error">
                <option value="">Choose an answer</option>
                @for (var index = 0; index < Model.Question.Options.Length; index++)
                {
                    <option value="@index">@Model.Question.Options[index]</option>
                }
            </select>
            <span asp-validation-for="Answer" id="answer-error" class="temperature-errors"></span>
            <p id="answer-help" class="example-hint">@Model.AttemptsRemaining of @Model.AttemptLimit attempts remaining. Choose New quiz for a fresh round.</p>
            <div class="temperature-actions">
                <button class="temperature-confirm" type="submit" disabled="@Model.IsFinished">Check answer</button>
                <a id="loop-reset" class="temperature-clear" href="/concepts/loops/example-5">New quiz</a>
            </div>
            <details class="decision-flow"><summary>How the @Model.LoopKind loop works</summary><pre tabindex="0" aria-label="@Model.Title loop structure">@Model.Code</pre></details>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="loop-result-title">
            <h5 id="loop-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                @* The shared script restores this message when an edit hides an old result. *@
                <p class="example-empty" data-example-empty hidden="@(Model.Result is not null)">Your result will appear here.</p>
                <div class="example-result" data-example-result hidden="@(Model.Result is null)" tabindex="-1">
                    <span class="example-result-label">@Model.LoopKind loop</span>
                    <strong>@Model.Result</strong>
                    <span>@Model.Detail</span>
                    @if (Model.Steps.Count > 0)
                    {
                        <h6 class="decision-path-title">Loop steps</h6>
                        <ol class="decision-path">@foreach (var step in Model.Steps) { <li>@step</li> }</ol>
                    }
                </div>
            </div>
        </section>
    </form>
</div>
