@model SumDigitsViewModel
<label asp-for="Number">Whole number</label>
<input asp-for="Number" inputmode="numeric" maxlength="18" pattern="[0-9]{1,18}" required class="example-input" aria-describedby="number-help number-error" placeholder="For example, 472" />
<span asp-validation-for="Number" id="number-error" class="temperature-errors"></span>
<p id="number-help" class="example-hint">Enter up to 18 digits. Zero and leading zeros are supported.</p>
