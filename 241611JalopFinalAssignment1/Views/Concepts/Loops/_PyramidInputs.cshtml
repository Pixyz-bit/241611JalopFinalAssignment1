@model PyramidViewModel
<div class="example-input-fields">
    <div>
        <label asp-for="Rows">Rows</label>
        <input asp-for="Rows" type="number" min="1" max="20" step="1" required class="example-input" aria-invalid="@(ViewData.ModelState[nameof(Model.Rows)]?.Errors.Count > 0 ? "true" : null)" aria-describedby="rows-error" />
        <span asp-validation-for="Rows" id="rows-error" class="temperature-errors"></span>
    </div>
    <div>
        <label asp-for="Symbol">Symbol</label>
        <input asp-for="Symbol" maxlength="1" required class="example-input" aria-invalid="@(ViewData.ModelState[nameof(Model.Symbol)]?.Errors.Count > 0 ? "true" : null)" aria-describedby="symbol-error" />
        <span asp-validation-for="Symbol" id="symbol-error" class="temperature-errors"></span>
    </div>
</div>
