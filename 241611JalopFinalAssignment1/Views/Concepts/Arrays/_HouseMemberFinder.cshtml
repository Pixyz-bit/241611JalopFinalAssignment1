@model HouseMemberFinderViewModel
<div class="example-workspace example-split array-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    @* This form posts directly to ArraysController.FindHouse(). *@
    <form asp-controller="Arrays" asp-action="FindHouse" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="array-input-title">
            <h5 id="array-input-title">Input</h5>
            @* Errors link back to the inputs that need attention. *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="decision-errors" role="alert" tabindex="-1" data-array-errors>
                    <h5>Check your inputs</h5>
                    <ul>
                        @foreach (var field in ViewData.ModelState)
                        {
                            // A game-token error links to New game; other errors link to their input.
                            var target = field.Key == "StateToken" ? "array-reset" : field.Key;
                            @foreach (var error in field.Value.Errors) { <li><a href="#@target">@error.ErrorMessage</a></li> }
                        }
                    </ul>
                </div>
            }
            @* All input controls for this example are written below. *@
            <div class="example-input-fields">
                <div>
                    <label asp-for="Gryffindor">Gryffindor members</label>
                    <textarea asp-for="Gryffindor" class="example-input example-textarea house-roster" rows="2" maxlength="1220" aria-describedby="gryffindor-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Gryffindor)]?.Errors.Count > 0 ? "true" : null)"></textarea>
                    <span asp-validation-for="Gryffindor" id="gryffindor-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Slytherin">Slytherin members</label>
                    <textarea asp-for="Slytherin" class="example-input example-textarea house-roster" rows="2" maxlength="1220" aria-describedby="slytherin-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Slytherin)]?.Errors.Count > 0 ? "true" : null)"></textarea>
                    <span asp-validation-for="Slytherin" id="slytherin-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Ravenclaw">Ravenclaw members</label>
                    <textarea asp-for="Ravenclaw" class="example-input example-textarea house-roster" rows="2" maxlength="1220" aria-describedby="ravenclaw-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Ravenclaw)]?.Errors.Count > 0 ? "true" : null)"></textarea>
                    <span asp-validation-for="Ravenclaw" id="ravenclaw-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Hufflepuff">Hufflepuff members</label>
                    <textarea asp-for="Hufflepuff" class="example-input example-textarea house-roster" rows="2" maxlength="1220" aria-describedby="hufflepuff-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Hufflepuff)]?.Errors.Count > 0 ? "true" : null)"></textarea>
                    <span asp-validation-for="Hufflepuff" id="hufflepuff-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Member">Member to find</label>
                    <input asp-for="Member" class="example-input" required maxlength="60" aria-describedby="member-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Member)]?.Errors.Count > 0 ? "true" : null)" />
                    <span asp-validation-for="Member" id="member-error" class="temperature-errors"></span>
                </div>
            </div>
            <div class="temperature-actions">
                <button class="temperature-confirm" type="submit">Find house</button>
                <a id="array-reset" class="temperature-clear" href="/concepts/arrays/example-5">Clear</a>
            </div>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="array-result-title">
            <h5 id="array-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                @* Editing an input can restore this empty message through the shared JavaScript. *@
                <p class="example-empty" data-example-empty hidden="@(Model.Result is not null)">Your result will appear here.</p>
                <div class="example-result" data-example-result hidden="@(Model.Result is null)" tabindex="-1">
                    <span class="example-result-label">@Model.Dimension</span>
                    <strong>@Model.Result</strong>
                    <span>@Model.Detail</span>
                    @* Display the results that the controller stored in this example model. *@
                    @if (Model.Matches.Count > 0)
                    {
                        <div class="array-table-scroll" tabindex="0" role="region" aria-label="Matching houses">
                            <table class="array-table"><caption>Matching houses</caption>
                                <thead><tr><th scope="col">House</th><th scope="col">Member</th><th scope="col">Array index</th></tr></thead>
                                <tbody>
                                @foreach (var match in Model.Matches)
                                {
                                    @* Razor encodes entered names so they are displayed as text. *@
                                    <tr><th scope="row">@match.House</th><td>@match.Member</td><td>[@match.Row, @match.Column]</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </section>
    </form>
</div>
