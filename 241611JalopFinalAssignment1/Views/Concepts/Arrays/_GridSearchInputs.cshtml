@model GridSearchViewModel
<fieldset id="Cells" class="array-fieldset" tabindex="-1">
    <legend>Number grid</legend>
    <div class="array-input-grid">
        @for (var index = 0; index < 9; index++)
        {
            <div>
                <label asp-for="Cells[index]" class="sr-only">Row @(index / 3 + 1), column @(index % 3 + 1)</label>
                <input asp-for="Cells[index]" class="example-input" type="number" step="any" min="-1000000000" max="1000000000" required aria-describedby="cell-error-@index" aria-invalid="@(ViewData.ModelState[$"Cells[{index}]"]?.Errors.Count > 0 ? "true" : null)" />
                <span asp-validation-for="Cells[index]" id="cell-error-@index" class="temperature-errors"></span>
            </div>
        }
    </div>
</fieldset>
<div class="array-search-value">
    <label asp-for="SearchValue">Number to find</label>
    <input asp-for="SearchValue" type="number" step="any" min="-1000000000" max="1000000000" required class="example-input" aria-describedby="search-error" aria-invalid="@(ViewData.ModelState[nameof(Model.SearchValue)]?.Errors.Count > 0 ? "true" : null)" />
    <span asp-validation-for="SearchValue" id="search-error" class="temperature-errors"></span>
</div>
<p class="example-hint">Sample numbers are editable. Fill all nine cells; decimals and repeated values are supported.</p>
