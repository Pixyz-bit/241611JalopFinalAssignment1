@model JALOPARLANMARTIN_241611_MultiplicationTableViewModel
<div class="example-workspace example-split array-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    @* This form posts directly to JALOPARLANMARTIN_241611_ArraysController.GenerateTable(). *@
    <form asp-controller="JALOPARLANMARTIN_241611_Arrays" asp-action="GenerateTable" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="array-input-title">
            <h5 id="array-input-title">Input</h5>
            @* Errors link back to the inputs that need attention. *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="decision-errors" role="alert" tabindex="-1" data-array-errors>
                    <h5>Check your inputs</h5>
                    <ul>
                        @foreach (var field in ViewData.ModelState)
                        {
                            // A game-token error links to New game; other errors link to their input.
                            var target = field.Key == "StateToken" ? "array-reset" : field.Key;
                            @foreach (var error in field.Value.Errors) { <li><a href="#@target">@error.ErrorMessage</a></li> }
                        }
                    </ul>
                </div>
            }
            @* All input controls for this example are written below. *@
            <div class="example-input-fields">
                <div>
                    <label asp-for="Rows">Rows (1–12)</label>
                    <input asp-for="Rows" class="example-input" type="number" min="1" max="12" step="1" required aria-describedby="rows-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Rows)]?.Errors.Count > 0 ? "true" : null)" />
                    <span asp-validation-for="Rows" id="rows-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Columns">Columns (1–12)</label>
                    <input asp-for="Columns" class="example-input" type="number" min="1" max="12" step="1" required aria-describedby="columns-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Columns)]?.Errors.Count > 0 ? "true" : null)" />
                    <span asp-validation-for="Columns" id="columns-error" class="temperature-errors"></span>
                </div>
            </div>
            <div class="temperature-actions">
                <button class="temperature-confirm" type="submit">Generate table</button>
                <a id="array-reset" class="temperature-clear" href="/concepts/arrays/example-4">Clear</a>
            </div>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="array-result-title">
            <h5 id="array-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                @* Editing an input can restore this empty message through the shared JavaScript. *@
                <p class="example-empty" data-example-empty hidden="@(Model.Result is not null)">Your result will appear here.</p>
                <div class="example-result" data-example-result hidden="@(Model.Result is null)" tabindex="-1">
                    <span class="example-result-label">@Model.Dimension</span>
                    <strong>@Model.Result</strong>
                    <span>@Model.Detail</span>
                    @* Display the results that the controller stored in this example model. *@
                    @if (Model.Products is not null)
                    {
                        @* Local scrolling keeps a 12-column table inside its result panel on phones. *@
                        <div class="array-table-scroll multiplication-result" tabindex="0" role="region" aria-label="Multiplication table">
                            <table class="array-table"><caption>Row × column</caption>
                                <thead><tr><th scope="col">×</th>@for (var column = 0; column < Model.Products.GetLength(1); column++) { <th scope="col">@(column + 1)</th> }</tr></thead>
                                <tbody>
                                @for (var row = 0; row < Model.Products.GetLength(0); row++)
                                {
                                    <tr><th scope="row">@(row + 1)</th>
                                        @for (var column = 0; column < Model.Products.GetLength(1); column++) { <td>@Model.Products[row, column]</td> }
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </section>
    </form>
</div>
