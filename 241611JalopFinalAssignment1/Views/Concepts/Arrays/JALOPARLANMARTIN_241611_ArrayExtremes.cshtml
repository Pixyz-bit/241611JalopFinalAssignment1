@model JALOPARLANMARTIN_241611_ArrayExtremesViewModel
<div class="example-workspace example-split array-example array-extremes">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    @* A native POST runs the nested C# loops even when JavaScript is unavailable. *@
    <form asp-controller="JALOPARLANMARTIN_241611_Arrays" asp-action="FindExtremes" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="array-input-title">
            <h5 id="array-input-title">Input</h5>
            @if (!ViewData.ModelState.IsValid)
            {
                @* A linked summary helps keyboard users return to the invalid field. *@
                <div class="decision-errors" role="alert" tabindex="-1" data-array-errors>
                    <h5>Check your inputs</h5>
                    <ul>
                        @foreach (var field in ViewData.ModelState)
                        {
                            @foreach (var error in field.Value.Errors)
                            {
                                <li><a href="#@field.Key">@error.ErrorMessage</a></li>
                            }
                        }
                    </ul>
                </div>
            }
            @* Each field supplies one complete array row. *@
            <div class="example-input-fields">
                <div>
                    <label asp-for="Row1">Row 1</label>
                    <input asp-for="Row1" class="example-input" required maxlength="500" aria-describedby="matrix-format row1-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Row1)]?.Errors.Count > 0 ? "true" : null)" placeholder="8, 3, 12" />
                    <span asp-validation-for="Row1" id="row1-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Row2">Row 2</label>
                    <input asp-for="Row2" class="example-input" required maxlength="500" aria-describedby="matrix-format row2-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Row2)]?.Errors.Count > 0 ? "true" : null)" placeholder="-4, 7, 2" />
                    <span asp-validation-for="Row2" id="row2-error" class="temperature-errors"></span>
                </div>
                <div>
                    <label asp-for="Row3">Row 3</label>
                    <input asp-for="Row3" class="example-input" required maxlength="500" aria-describedby="matrix-format row3-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Row3)]?.Errors.Count > 0 ? "true" : null)" placeholder="6, 0, 9" />
                    <span asp-validation-for="Row3" id="row3-error" class="temperature-errors"></span>
                </div>
            </div>
            <p id="matrix-format" class="example-hint">Separate numbers with commas. All three rows must have the same number of values (1–12).</p>
            <div class="temperature-actions">
                <button class="temperature-confirm" type="submit">Find largest and smallest</button>
                <a id="array-reset" class="temperature-clear" href="/concepts/arrays/example-3">Clear</a>
            </div>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="array-result-title">
            <h5 id="array-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <p class="example-empty" data-example-empty hidden="@(Model.Result is not null)">Your result will appear here.</p>
                <div class="example-result" data-example-result hidden="@(Model.Result is null)" tabindex="-1">
                    <span class="example-result-label">@Model.Dimension</span>
                    @* Reuse the existing metric typography; each index belongs to its value. *@
                    <div class="rectangle-metric">
                        <h6>Largest</h6>
                        <strong class="example-result-value" data-array-largest>@Model.Largest?.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture)</strong>
                        <p class="example-result-label" data-largest-index>Index [@Model.LargestRow, @Model.LargestColumn]</p>
                    </div>
                    <div class="rectangle-metric">
                        <h6>Smallest</h6>
                        <strong class="example-result-value" data-array-smallest>@Model.Smallest?.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture)</strong>
                        <p class="example-result-label" data-smallest-index>Index [@Model.SmallestRow, @Model.SmallestColumn]</p>
                    </div>
                    <span>@Model.Detail</span>
                    @if (Model.Numbers is not null)
                    {
                        @* Two nested loops render the actual row and column indexes. Wide tables scroll locally. *@
                        <div class="array-table-scroll multiplication-result" tabindex="0" role="region" aria-label="Entered 2D array">
                            <table class="array-table">
                                <caption>2D array (zero-based indexes)</caption>
                                <thead><tr><th scope="col">Row / column</th>
                                    @for (var column = 0; column < Model.Numbers.GetLength(1); column++)
                                    {
                                        <th scope="col">@column</th>
                                    }
                                </tr></thead>
                                <tbody>
                                @for (var row = 0; row < Model.Numbers.GetLength(0); row++)
                                {
                                    <tr><th scope="row">@row</th>
                                        @for (var column = 0; column < Model.Numbers.GetLength(1); column++)
                                        {
                                            <td>@Model.Numbers[row, column].ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture)</td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </section>
    </form>
</div>
