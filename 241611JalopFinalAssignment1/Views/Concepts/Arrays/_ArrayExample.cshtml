@model ArrayExampleViewModel
<div class="example-workspace example-split array-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    <p class="detail-description">@Model.Description</p>
    @* One native form preserves the same panel layout and no-JavaScript behavior as the other examples. *@
    <form asp-controller="Arrays" asp-action="@Model.ActionName" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="array-input-title">
            <h5 id="array-input-title">Input</h5>
            <partial name="~/Views/Concepts/Arrays/_ArrayErrors.cshtml" />
            <partial name="@($"~/Views/Concepts/Arrays/{Model.InputPartial}.cshtml")" model="Model" />
            <div class="temperature-actions">
                @if (Model.ShowSubmit) { <button class="temperature-confirm" type="submit">@Model.SubmitLabel</button> }
                <a id="array-reset" class="temperature-clear" href="/concepts/arrays/example-@Model.Number">@Model.ClearLabel</a>
            </div>
        </section>
        <section class="example-panel example-output-panel" aria-labelledby="array-result-title">
            <h5 id="array-result-title">Result</h5>
            <div class="example-result-status" role="status" aria-atomic="true">
                <partial name="_ExampleEmpty" model="@(Model.Result is not null)" />
                <div class="example-result" data-example-result hidden="@(Model.Result is null)" tabindex="-1">
                    <span class="example-result-label">@Model.Dimension</span>
                    <strong>@Model.Result</strong>
                    <span>@Model.Detail</span>
                    @* Each typed result partial supplies only its array-specific data artifact. *@
                    <partial name="@($"~/Views/Concepts/Arrays/{Model.ResultPartial}.cshtml")" model="Model" />
                </div>
            </div>
        </section>
    </form>
</div>
