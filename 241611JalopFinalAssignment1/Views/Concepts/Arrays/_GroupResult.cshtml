@model GroupOrganizerViewModel
@if (Model.Groups is not null)
{
    <div class="array-table-scroll">
        <table class="array-table"><caption>Organized groups</caption><thead><tr><th scope="col">Group</th>@for (var member = 0; member < 3; member++) { <th scope="col">Member @(member + 1)</th> }</tr></thead><tbody>
        @for (var group = 0; group < 3; group++)
        {
            <tr><th scope="row">Group @(group + 1)</th>@for (var member = 0; member < 3; member++) { <td>@Model.Groups[group, member]</td> }</tr>
        }
        </tbody></table>
    </div>
}
