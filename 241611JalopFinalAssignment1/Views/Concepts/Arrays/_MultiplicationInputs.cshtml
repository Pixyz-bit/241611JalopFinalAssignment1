@model MultiplicationTableViewModel
<div class="example-input-fields">
    <div>
        <label asp-for="Rows">Rows (1–12)</label>
        <input asp-for="Rows" class="example-input" type="number" min="1" max="12" step="1" required aria-describedby="rows-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Rows)]?.Errors.Count > 0 ? "true" : null)" />
        <span asp-validation-for="Rows" id="rows-error" class="temperature-errors"></span>
    </div>
    <div>
        <label asp-for="Columns">Columns (1–12)</label>
        <input asp-for="Columns" class="example-input" type="number" min="1" max="12" step="1" required aria-describedby="columns-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Columns)]?.Errors.Count > 0 ? "true" : null)" />
        <span asp-validation-for="Columns" id="columns-error" class="temperature-errors"></span>
    </div>
</div>
