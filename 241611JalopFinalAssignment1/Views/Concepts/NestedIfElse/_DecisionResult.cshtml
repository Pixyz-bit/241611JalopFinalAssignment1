@model NestedExampleViewModel
@* All output comes from C#; Razor encodes text before placing it in the page. *@
<section class="example-panel example-output-panel" aria-labelledby="decision-result-title">
    <h5 id="decision-result-title">Result</h5>
    <div class="example-result-status" role="status" aria-atomic="true">
        <partial name="_ExampleEmpty" model="@(Model.Result is not null)" />
        <div class="example-result" data-example-result hidden="@(Model.Result is null)" tabindex="-1">
            <span class="example-result-label">Decision result</span>
            <strong>@Model.Result</strong>
            <span>@Model.Detail</span>
            <h6 class="decision-path-title">Decision path</h6>
            <ol class="decision-path">@foreach (var decision in Model.Decisions) { <li>@decision</li> }</ol>
        </div>
    </div>
</section>
