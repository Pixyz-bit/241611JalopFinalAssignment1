@model LoginAccessViewModel
<div class="example-workspace nested-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    <p class="detail-description">@Model.Description</p>
    <form asp-controller="NestedIfElse" asp-action="CheckAccess" method="post" class="example-form" data-example-form>
        <partial name="~/Views/Concepts/NestedIfElse/_DecisionErrors.cshtml" model="Model" />
        @* Real labels and linked errors keep the form usable with a keyboard or screen reader. *@
        <div class="example-fields">
            <div><label asp-for="Username">Sample username</label><input asp-for="Username" class="example-input" required autocomplete="off" maxlength="40" aria-describedby="username-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Username)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Username" id="username-error" class="temperature-errors"></span></div>
            <div><label asp-for="Password">Sample password</label><input asp-for="Password" class="example-input" required autocomplete="off" maxlength="80" aria-describedby="password-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Password)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Password" id="password-error" class="temperature-errors"></span></div>
        </div>
        <div class="temperature-actions"><button class="temperature-confirm" type="submit">Check access</button><a class="temperature-clear" href="/concepts/nested-if-else/example-1">Clear</a></div>
        <p class="example-hint" data-example-hint>Use the public sample accounts below. Account names and passwords are case-sensitive.</p>
        <partial name="~/Views/Concepts/NestedIfElse/_DecisionResult.cshtml" model="Model" />
    </form>
    <details class="decision-flow" open>
        <summary>Sample accounts</summary>
        <div class="sample-accounts"><table><caption class="sr-only">Public teaching accounts</caption><thead><tr><th scope="col">Username</th><th scope="col">Password</th><th scope="col">Role</th></tr></thead><tbody><tr><td>admin</td><td>admin123</td><td>Admin</td></tr><tr><td>student</td><td>student123</td><td>Student</td></tr><tr><td>guest</td><td>guest123</td><td>Guest</td></tr></tbody></table></div>
    </details>
    <partial name="~/Views/Concepts/NestedIfElse/_DecisionFlow.cshtml" model="Model" />
</div>
