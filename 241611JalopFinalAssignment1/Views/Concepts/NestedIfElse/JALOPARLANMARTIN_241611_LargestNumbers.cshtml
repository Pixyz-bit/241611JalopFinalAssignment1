@model JALOPARLANMARTIN_241611_LargestNumbersViewModel
<div class="example-workspace example-split nested-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    @* Inputs and teaching notes stay together; the shared Result panel remains visible beside them. *@
    <form asp-controller="JALOPARLANMARTIN_241611_NestedIfElse" asp-action="FindLargest" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="decision-input-title">
            <h5 id="decision-input-title">Input</h5>
            <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_DecisionErrors.cshtml" model="Model" />
            @* Unlike triangle sides, these inputs allow zero and negative values. *@
            <div class="example-fields">
                <div><label asp-for="A">Number A</label><input asp-for="A" class="example-input" type="number" step="any" min="-1000000000000" max="1000000000000" required aria-describedby="a-error" aria-invalid="@(ViewData.ModelState[nameof(Model.A)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="A" id="a-error" class="temperature-errors"></span></div>
                <div><label asp-for="B">Number B</label><input asp-for="B" class="example-input" type="number" step="any" min="-1000000000000" max="1000000000000" required aria-describedby="b-error" aria-invalid="@(ViewData.ModelState[nameof(Model.B)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="B" id="b-error" class="temperature-errors"></span></div>
                <div><label asp-for="C">Number C</label><input asp-for="C" class="example-input" type="number" step="any" min="-1000000000000" max="1000000000000" required aria-describedby="c-error" aria-invalid="@(ViewData.ModelState[nameof(Model.C)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="C" id="c-error" class="temperature-errors"></span></div>
            </div>
            <div class="temperature-actions"><button class="temperature-confirm" type="submit">Find largest</button><a class="temperature-clear" href="/concepts/nested-if-else/example-5">Clear</a></div>
            <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_DecisionFlow.cshtml" model="Model" />
        </section>
        <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_DecisionResult.cshtml" model="Model" />
    </form>
</div>
