@model BmiCalculatorViewModel
<div class="example-workspace nested-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    <p class="detail-description">@Model.Description</p>
    <form asp-controller="NestedIfElse" asp-action="CalculateBmi" method="post" class="example-form" data-example-form>
        @* Unit labels prevent confusing a height in centimeters with the formula's meters. *@
        <div class="example-fields">
            <div><label asp-for="Weight">Weight (kg)</label><input asp-for="Weight" class="example-input" type="number" step="any" min="0.000001" max="1000000000" required placeholder="For example, 60" aria-describedby="weight-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Weight)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Weight" id="weight-error" class="temperature-errors"></span></div>
            <div><label asp-for="Height">Height (m)</label><input asp-for="Height" class="example-input" type="number" step="any" min="0.000001" max="1000000000" required placeholder="For example, 1.65" aria-describedby="height-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Height)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="Height" id="height-error" class="temperature-errors"></span></div>
        </div>
        <div class="temperature-actions"><button class="temperature-confirm" type="submit">Calculate BMI</button><a class="temperature-clear" href="/concepts/nested-if-else/example-3">Clear</a></div>
        <p class="example-hint" data-example-hint>Enter kilograms and meters, then choose Calculate BMI.</p>
        <partial name="~/Views/Concepts/NestedIfElse/_DecisionResult.cshtml" model="Model" />
        <p class="example-hint">Categories apply to adults aged 20 and older. BMI is a screening measure, not a diagnosis. <a href="https://www.cdc.gov/bmi/adult-calculator/bmi-categories.html">CDC adult BMI categories</a>.</p>
    </form>
    <partial name="~/Views/Concepts/NestedIfElse/_DecisionFlow.cshtml" model="Model" />
</div>
