@model LatinHonorsViewModel
<div class="example-workspace example-split nested-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    <form asp-controller="NestedIfElse" asp-action="EvaluateHonors" method="post" class="example-form example-layout" data-example-form>
        <section class="example-panel example-input-panel" aria-labelledby="honors-input-title">
            <h5 id="honors-input-title">Input</h5>
            <partial name="~/Views/Concepts/NestedIfElse/_DecisionErrors.cshtml" model="Model" />
            <div class="example-input-fields">
                <div>
                    <label asp-for="Gwa">General weighted average (GWA)</label>
                    <input asp-for="Gwa" class="example-input" type="number" min="1" max="5" step="any" required placeholder="For example, 1.25" aria-describedby="gwa-error" aria-invalid="@(ViewData.ModelState[nameof(Model.Gwa)]?.Errors.Count > 0 ? "true" : null)" />
                    <span asp-validation-for="Gwa" id="gwa-error" class="temperature-errors"></span>
                </div>
            </div>
            <div class="temperature-actions"><button class="temperature-confirm" type="submit">Evaluate honors</button><a class="temperature-clear" href="/concepts/nested-if-else/example-2">Clear</a></div>
            <partial name="~/Views/Concepts/NestedIfElse/_DecisionFlow.cshtml" model="Model" />
        </section>
        <partial name="~/Views/Concepts/NestedIfElse/_DecisionResult.cshtml" model="Model" />
    </form>
</div>
