@model TriangleClassifierViewModel
<div class="example-workspace nested-example">
    <div class="example-heading"><h4>@Model.Title</h4></div>
    <p class="detail-description">@Model.Description</p>
    <form asp-controller="NestedIfElse" asp-action="ClassifyTriangle" method="post" class="example-form" data-example-form>
        <partial name="~/Views/Concepts/NestedIfElse/_DecisionErrors.cshtml" model="Model" />
        @* Each side has its own validation message so invalid measurements are easy to locate. *@
        <div class="example-fields">
            <div><label asp-for="A">Side A</label><input asp-for="A" class="example-input" type="number" step="any" min="0.000001" max="1000000000000" required aria-describedby="a-error" aria-invalid="@(ViewData.ModelState[nameof(Model.A)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="A" id="a-error" class="temperature-errors"></span></div>
            <div><label asp-for="B">Side B</label><input asp-for="B" class="example-input" type="number" step="any" min="0.000001" max="1000000000000" required aria-describedby="b-error" aria-invalid="@(ViewData.ModelState[nameof(Model.B)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="B" id="b-error" class="temperature-errors"></span></div>
            <div><label asp-for="C">Side C</label><input asp-for="C" class="example-input" type="number" step="any" min="0.000001" max="1000000000000" required aria-describedby="c-error" aria-invalid="@(ViewData.ModelState[nameof(Model.C)]?.Errors.Count > 0 ? "true" : null)" /><span asp-validation-for="C" id="c-error" class="temperature-errors"></span></div>
        </div>
        <div class="temperature-actions"><button class="temperature-confirm" type="submit">Classify triangle</button><a class="temperature-clear" href="/concepts/nested-if-else/example-4">Clear</a></div>
        <p class="example-hint" data-example-hint>Try 5, 5, 5 for equilateral; 5, 5, 6 for isosceles; or 3, 4, 5 for scalene.</p>
        <partial name="~/Views/Concepts/NestedIfElse/_DecisionResult.cshtml" model="Model" />
    </form>
    <partial name="~/Views/Concepts/NestedIfElse/_DecisionFlow.cshtml" model="Model" />
</div>
