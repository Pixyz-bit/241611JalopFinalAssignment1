@model JALOPARLANMARTIN_241611_ShowcaseViewModel
@if (Model.HasWindow)
{
    <section class="showcase-window" aria-labelledby="window-title" data-window data-category="@Model.Category?.Slug">
        @* A single application title bar replaces Explorer tabs and the address bar. *@
        <header class="app-titlebar">
            <div class="app-identity"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><span>C# <span class="brand-extra">Programming </span>Showcase</span></div>
            <h2 id="window-title" class="sr-only">@Model.WindowTitle</h2>
            <div class="window-controls">
                <button class="caption-button" type="button" data-minimize aria-label="Minimize window"><svg class="icon" aria-hidden="true"><use href="#icon-minimize" /></svg></button>
                <button class="caption-button maximize" type="button" data-maximize aria-label="Maximize window" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#icon-maximize" /></svg></button>
                <a class="caption-button close" href="/" data-navigate aria-label="Close window"><svg class="icon" aria-hidden="true"><use href="#icon-close" /></svg></a>
            </div>
        </header>
        <div class="app-body">
        @* Group the category heading with its navigation, beside the example workspace. *@
        <div class="app-navigation">
        @if (Model.Category is not null)
        {
            <header class="app-page-heading">
                <partial name="JALOPARLANMARTIN_241611_ConceptIcon" model="Model.Category" />
                <div><h3 id="detail-title">@Model.Category.Name</h3></div>
            </header>
        }
            <nav class="app-sidebar @(Model.Category is not null ? "examples-sidebar" : "")" aria-label="@(Model.Category is not null ? $"{Model.Category.Name} examples" : "Categories")">
                @if (Model.Category is not null)
                {
                    @* Each sidebar entry opens an example in the current category using a real MVC route. *@
                    @for (var number = 1; number <= 5; number++)
                    {
                        <a href="/concepts/@Model.Category.Slug/example-@number" class="sidebar-link sidebar-example @(number == Model.Example ? "is-selected" : "")" data-navigate aria-current="@(number == Model.Example ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><span>@JALOPARLANMARTIN_241611_ExampleCatalog.GetTitle(Model.Category.Slug, number)</span></a>
                    }
                }

                <div class="sidebar-utilities">
                    <a href="/" class="sidebar-link" data-navigate><svg class="icon" aria-hidden="true"><use href="#icon-home" /></svg><span>Back to desktop</span></a>
                </div>
            </nav>
        </div>
                @* Working examples share one compact pane inset and a consistent input/result layout. *@
                <section class="example-detail @(Model.HasImplementedExample ? "example-detail--split" : "")" aria-labelledby="detail-title" tabindex="-1">
                    @if (Model.Temperature is not null)
                    {
                        @* Use the working converter instead of the generic placeholder. *@
                        <partial name="~/Views/Concepts/InputOutput/JALOPARLANMARTIN_241611_TemperatureConverter.cshtml"
                                 model="Model.Temperature" />
                    }
                    else if (Model.IdCard is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/JALOPARLANMARTIN_241611_IdCard.cshtml" model="Model.IdCard" />
                    }
                    else if (Model.Rectangle is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/JALOPARLANMARTIN_241611_RectangleCalculator.cshtml" model="Model.Rectangle" />
                    }
                    else if (Model.TextCounter is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/JALOPARLANMARTIN_241611_TextCounter.cshtml" model="Model.TextCounter" />
                    }
                    else if (Model.Time is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/JALOPARLANMARTIN_241611_TimeConverter.cshtml" model="Model.Time" />
                    }
                    else if (Model.Nested is JALOPARLANMARTIN_241611_LoginAccessViewModel login)
                    {
                        @* Each working nested example keeps the same canonical shell and sidebar. *@
                        <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_LoginAccess.cshtml" model="login" />
                    }
                    else if (Model.Nested is JALOPARLANMARTIN_241611_LatinHonorsViewModel grade)
                    {
                        <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_LatinHonors.cshtml" model="grade" />
                    }
                    else if (Model.Nested is JALOPARLANMARTIN_241611_BmiCalculatorViewModel bmi)
                    {
                        <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_BmiCalculator.cshtml" model="bmi" />
                    }
                    else if (Model.Nested is JALOPARLANMARTIN_241611_TriangleClassifierViewModel triangle)
                    {
                        <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_TriangleClassifier.cshtml" model="triangle" />
                    }
                    else if (Model.Nested is JALOPARLANMARTIN_241611_LargestNumbersViewModel largest)
                    {
                        <partial name="~/Views/Concepts/NestedIfElse/JALOPARLANMARTIN_241611_LargestNumbers.cshtml" model="largest" />
                    }
                    else if (Model.Loop is JALOPARLANMARTIN_241611_PyramidViewModel pyramid)
                    {
                        @* The model type selects this example's complete form and result view. *@
                        <partial name="~/Views/Concepts/Loops/JALOPARLANMARTIN_241611_PyramidGenerator.cshtml" model="pyramid" />
                    }
                    else if (Model.Loop is JALOPARLANMARTIN_241611_SumDigitsViewModel digits)
                    {
                        @* The model type selects this example's complete form and result view. *@
                        <partial name="~/Views/Concepts/Loops/JALOPARLANMARTIN_241611_SumOfDigits.cshtml" model="digits" />
                    }
                    else if (Model.Loop is JALOPARLANMARTIN_241611_PrimeFactorsViewModel factors)
                    {
                        @* The model type selects this example's complete form and result view. *@
                        <partial name="~/Views/Concepts/Loops/JALOPARLANMARTIN_241611_PrimeFactorization.cshtml" model="factors" />
                    }
                    else if (Model.Loop is JALOPARLANMARTIN_241611_GuessGameViewModel guess)
                    {
                        @* The model type selects this example's complete form and result view. *@
                        <partial name="~/Views/Concepts/Loops/JALOPARLANMARTIN_241611_NumberGuessingGame.cshtml" model="guess" />
                    }
                    else if (Model.Loop is JALOPARLANMARTIN_241611_DigitCounterViewModel digitCounter)
                    {
                        @* The model type selects this example's complete form and result view. *@
                        <partial name="~/Views/Concepts/Loops/JALOPARLANMARTIN_241611_DigitCounter.cshtml" model="digitCounter" />
                    }
                    else if (Model.ArrayExample is JALOPARLANMARTIN_241611_DuplicateFinderViewModel duplicates)
                    {
                        @* Select the complete view for this example using its model type. *@
                        <partial name="~/Views/Concepts/Arrays/JALOPARLANMARTIN_241611_DuplicateFinder.cshtml" model="duplicates" />
                    }
                    else if (Model.ArrayExample is JALOPARLANMARTIN_241611_ArraySortViewModel sort)
                    {
                        @* Select the complete view for this example using its model type. *@
                        <partial name="~/Views/Concepts/Arrays/JALOPARLANMARTIN_241611_ArraySort.cshtml" model="sort" />
                    }
                    else if (Model.ArrayExample is JALOPARLANMARTIN_241611_ArrayExtremesViewModel extremes)
                    {
                        @* Select the complete view for this example using its model type. *@
                        <partial name="~/Views/Concepts/Arrays/JALOPARLANMARTIN_241611_ArrayExtremes.cshtml" model="extremes" />
                    }
                    else if (Model.ArrayExample is JALOPARLANMARTIN_241611_MultiplicationTableViewModel multiplication)
                    {
                        @* Select the complete view for this example using its model type. *@
                        <partial name="~/Views/Concepts/Arrays/JALOPARLANMARTIN_241611_MultiplicationTable.cshtml" model="multiplication" />
                    }
                    else if (Model.ArrayExample is JALOPARLANMARTIN_241611_HouseMemberFinderViewModel houseMembers)
                    {
                        @* Select the complete view for this example using its model type. *@
                        <partial name="~/Views/Concepts/Arrays/JALOPARLANMARTIN_241611_HouseMemberFinder.cshtml" model="houseMembers" />
                    }
                    else if (Model.Example.HasValue)
                    {
                        <div class="example-workspace">
                            <div class="example-heading"><h4>Example @Model.Example.Value.ToString("00")</h4><span class="status-pill"><span></span>Not implemented yet</span></div>
                            <p class="detail-description">A blank canvas for your next idea.</p>
                            <div class="template-section"><h5>Description</h5><p>Add the example’s title and explain what it does.</p></div>
                            <div class="template-section"><h5>Interface</h5><div class="empty-interface"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><p>Your inputs and controls will go here.</p></div></div>
                            <div class="template-section"><h5>Output</h5><p>The result will appear here when you add your C# logic.</p></div>
                        </div>
                    }

                </section>
        </div>
    </section>
}
