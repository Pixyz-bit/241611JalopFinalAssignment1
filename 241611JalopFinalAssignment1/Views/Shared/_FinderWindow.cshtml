@model ShowcaseViewModel
@if (Model.HasWindow)
{
    <section class="finder-window @(Model.IsAbout ? "about-window" : "")" aria-labelledby="window-title" data-window data-category="@Model.Category?.Slug">
        <header class="window-toolbar">
            <div class="traffic-lights">
                <a class="traffic-light close" href="/" data-navigate aria-label="Close window"><span aria-hidden="true">×</span></a>
                <button class="traffic-light minimize" type="button" data-minimize aria-label="Minimize window"><span aria-hidden="true">−</span></button>
                <button class="traffic-light maximize" type="button" data-maximize aria-label="Maximize window" aria-pressed="false"><span aria-hidden="true">+</span></button>
            </div>
            <a href="@(Model.Example.HasValue ? $"/concepts/{Model.Category!.Slug}" : "/")" data-navigate class="window-back" aria-label="@(Model.Example.HasValue ? "Back to category" : "Back to desktop")"><svg class="icon"><use href="#icon-chevron" /></svg></a>
            <h2 id="window-title">@Model.WindowTitle</h2>
            <span class="window-toolbar-detail">@(Model.IsAbout ? "Read me" : "5 examples")</span>
            <button class="plain-button window-search" data-search-open type="button" aria-label="Search concepts"><svg class="icon"><use href="#icon-search" /></svg></button>
        </header>
        @if (Model.IsAbout)
        {
            <div class="about-content">
                <span class="about-logo"><svg class="icon"><use href="#icon-code" /></svg></span>
                <h3>A place to think<br />in <span>C#.</span></h3>
                <p>Welcome to C# Programming Showcase: a small collection of programming fundamentals, with a familiar desktop to explore them in.</p>
                <div class="about-facts"><span>4 concepts</span><span>20 example slots</span><span>ASP.NET Core MVC</span></div>
                <p class="about-note">The stage is set. The examples are yours to create.</p>
                <a href="/concepts/input-output" class="primary-link" data-navigate>Open the first folder <svg class="icon"><use href="#icon-arrow" /></svg></a>
            </div>
        }
        else
        {
            <div class="finder-body">
                <nav class="finder-sidebar" aria-label="Categories">
                    <p class="sidebar-caption">Your collection</p>
                    <a href="/" class="sidebar-link" data-navigate><svg class="icon"><use href="#icon-home" /></svg><span>Desktop</span></a>
                    <p class="sidebar-caption concepts-caption">Concepts</p>
                    @foreach (var category in ConceptCatalog.Categories)
                    {
                        <a href="/concepts/@category.Slug" class="sidebar-link @(category == Model.Category ? "is-selected" : "")" data-navigate aria-current="@(category == Model.Category ? "page" : null)"><svg class="icon sidebar-icon-@category.Accent"><use href="#icon-@category.Icon" /></svg><span>@category.Name</span><small>5</small></a>
                    }
                    <div class="sidebar-bottom"><svg class="icon"><use href="#icon-code" /></svg><span>A little code,<br />a lot to discover.</span></div>
                </nav>
                <nav class="example-list" aria-label="@Model.Category!.Name examples">
                    <div class="list-heading"><span>Examples</span><svg class="icon"><use href="#icon-grid" /></svg></div>
                    @for (var number = 1; number <= 5; number++)
                    {
                        <a class="example-row @(number == Model.Example ? "is-selected" : "")" href="/concepts/@Model.Category.Slug/example-@number" data-navigate aria-label="Example @number.ToString("00"), not implemented yet" aria-current="@(number == Model.Example ? "page" : null)"><span class="file-icon"><svg class="icon"><use href="#icon-file" /></svg><span>C#</span></span><span class="example-row-text"><span class="example-prefix">Example </span>@number.ToString("00")<small>Not implemented yet</small></span><svg class="icon row-chevron"><use href="#icon-chevron" /></svg></a>
                    }
                    <p class="list-footnote">A starting point for your ideas.</p>
                </nav>
                <section class="example-detail" aria-labelledby="detail-title" tabindex="-1">
                    @if (Model.Example.HasValue)
                    {
                        <div class="detail-breadcrumb">@Model.Category.Name <svg class="icon"><use href="#icon-chevron" /></svg> Example @Model.Example.Value.ToString("00")</div>
                        <span class="status-pill"><span></span>Not implemented yet</span>
                        <h3 id="detail-title">Example @Model.Example.Value.ToString("00")<span class="title-extension">.cs</span></h3>
                        <p class="detail-description">A blank canvas for your next idea.</p>
                        <div class="template-section"><h4>Description</h4><p>Add the example’s title and explain what it does.</p></div>
                        <div class="template-section"><h4>Interface</h4><div class="empty-interface"><svg class="icon"><use href="#icon-code" /></svg><p>Your inputs and controls will go here.</p></div></div>
                        <div class="template-section"><h4>Output</h4><p>The result will appear here when you add your C# logic.</p></div>
                    }
                    else
                    {
                        <div class="category-overview"><span class="overview-folder"><img src="~/images/folder.svg" width="112" height="92" alt="" /><svg class="icon"><use href="#icon-@Model.Category.Icon" /></svg></span><h3 id="detail-title">@Model.Category.Name</h3><p>@Model.Category.Description</p><span class="overview-count">5 examples waiting to take shape</span><a class="primary-link" href="/concepts/@Model.Category.Slug/example-1" data-navigate>Open Example 01 <svg class="icon"><use href="#icon-arrow" /></svg></a></div>
                    }
                </section>
            </div>
        }
        <footer class="window-status"><span><svg class="icon"><use href="#icon-folder" /></svg> @(Model.IsAbout ? "C# Programming Showcase" : $"Concepts / {Model.Category!.Name}")</span><span>@(Model.IsAbout ? ".NET 8" : Model.Example.HasValue ? $"Example {Model.Example.Value:00} of 05" : "5 items")</span></footer>
    </section>
}
