@model ShowcaseViewModel
@if (Model.HasWindow)
{
    <section class="showcase-window @(Model.IsAbout ? "about-window" : "")" aria-labelledby="window-title" data-window data-category="@Model.Category?.Slug">
        @* A single application title bar replaces Explorer tabs and the address bar. *@
        <header class="app-titlebar">
            <div class="app-identity"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><span>C# <span class="brand-extra">Programming </span>Showcase</span></div>
            <h2 id="window-title" class="sr-only">@Model.WindowTitle</h2>
            <div class="window-controls">
                <button class="caption-button" type="button" data-minimize aria-label="Minimize window"><svg class="icon" aria-hidden="true"><use href="#icon-minimize" /></svg></button>
                <button class="caption-button maximize" type="button" data-maximize aria-label="Maximize window" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="#icon-maximize" /></svg></button>
                <a class="caption-button close" href="/" data-navigate aria-label="Close window"><svg class="icon" aria-hidden="true"><use href="#icon-close" /></svg></a>
            </div>
        </header>
        @if (Model.Category is not null)
        {
            @* This full-width category header stays below the titlebar and above both content columns. *@
            <header class="app-page-heading">
                <partial name="_ConceptIcon" model="Model.Category" />
                <div><h3 id="detail-title">@Model.Category.Name</h3><p>@Model.Category.Description</p></div>
            </header>
        }
        <div class="app-body">
            <nav class="app-sidebar @(Model.Category is not null ? "examples-sidebar" : "")" aria-label="@(Model.Category is not null ? $"{Model.Category.Name} examples" : "Categories")">
                <p class="sidebar-caption">@(Model.Category is not null ? "Examples" : "Concepts")</p>
                @if (Model.Category is not null)
                {
                    @* Each sidebar entry opens an example in the current category using a real MVC route. *@
                    @for (var number = 1; number <= 5; number++)
                    {
                        <a href="/concepts/@Model.Category.Slug/example-@number" class="sidebar-link sidebar-example @(number == Model.Example ? "is-selected" : "")" data-navigate aria-current="@(number == Model.Example ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><span><span class="sidebar-example-word">Example </span>@number</span></a>
                    }
                }
                else
                {
                    @* About has no selected category, so it keeps category shortcuts available. *@
                    @foreach (var category in ConceptCatalog.Categories)
                    {
                        <a href="/concepts/@category.Slug" class="sidebar-link" data-navigate><svg class="icon" aria-hidden="true"><use href="#icon-@category.Icon" /></svg><span>@category.Name</span></a>
                    }
                }
                <div class="sidebar-utilities">
                    <a href="/about" class="sidebar-link @(Model.IsAbout ? "is-selected" : "")" data-navigate aria-current="@(Model.IsAbout ? "page" : null)"><svg class="icon" aria-hidden="true"><use href="#icon-info" /></svg><span>About this app</span></a>
                    <a href="/" class="sidebar-link" data-navigate><svg class="icon" aria-hidden="true"><use href="#icon-home" /></svg><span>Back to desktop</span></a>
                </div>
            </nav>
            @if (Model.IsAbout)
            {
                <section class="about-content" aria-labelledby="about-title" tabindex="-1">
                    <span class="about-logo"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg></span>
                    <h3 id="about-title">A place to think<br />in <span>C#.</span></h3>
                    <p>Welcome to C# Programming Showcase: a small collection of programming fundamentals, with a familiar Windows application to explore them in.</p>
                    <div class="about-facts"><span>4 concepts</span><span>20 example slots</span><span>ASP.NET Core MVC</span></div>
                    <p class="about-note">The stage is set. The examples are yours to create.</p>
                    <a href="/concepts/input-output" class="primary-link" data-navigate>Explore Input/Output <svg class="icon" aria-hidden="true"><use href="#icon-arrow" /></svg></a>
                </section>
            }
            else
            {
                <section class="example-detail" aria-labelledby="detail-title" tabindex="-1">
                    @if (Model.Temperature is not null)
                    {
                        @* Use the working converter instead of the generic placeholder. *@
                        <partial name="~/Views/Concepts/InputOutput/_TemperatureConverter.cshtml"
                                 model="Model.Temperature" />
                    }
                    else if (Model.IdCard is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/_IdCard.cshtml" model="Model.IdCard" />
                    }
                    else if (Model.TextCounter is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/_TextCounter.cshtml" model="Model.TextCounter" />
                    }
                    else if (Model.Time is not null)
                    {
                        <partial name="~/Views/Concepts/InputOutput/_TimeConverter.cshtml" model="Model.Time" />
                    }
                    else if (Model.Nested is LoginAccessViewModel login)
                    {
                        @* Each working nested example keeps the same canonical shell and sidebar. *@
                        <partial name="~/Views/Concepts/NestedIfElse/_LoginAccess.cshtml" model="login" />
                    }
                    else if (Model.Nested is AtmWithdrawalViewModel atm)
                    {
                        <partial name="~/Views/Concepts/NestedIfElse/_AtmWithdrawal.cshtml" model="atm" />
                    }
                    else if (Model.Example.HasValue)
                    {
                        <div class="example-workspace">
                            <div class="example-heading"><h4>Example @Model.Example.Value.ToString("00")</h4><span class="status-pill"><span></span>Not implemented yet</span></div>
                            <p class="detail-description">A blank canvas for your next idea.</p>
                            <div class="template-section"><h5>Description</h5><p>Add the example’s title and explain what it does.</p></div>
                            <div class="template-section"><h5>Interface</h5><div class="empty-interface"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><p>Your inputs and controls will go here.</p></div></div>
                            <div class="template-section"><h5>Output</h5><p>The result will appear here when you add your C# logic.</p></div>
                        </div>
                    }
                    else
                    {
                        <div class="category-intro"><svg class="icon" aria-hidden="true"><use href="#icon-code" /></svg><div><h4>Choose an example to get started</h4><p>Five example slots are ready for your ideas. Select an example in the navigation to open its description, interface, and output.</p><a class="primary-link" href="/concepts/@Model.Category!.Slug/example-1" data-navigate>Open Example 01 <svg class="icon" aria-hidden="true"><use href="#icon-arrow" /></svg></a></div></div>
                    }
                </section>
            }
        </div>
        <footer class="app-statusbar"><span>@(Model.IsAbout ? "C# Programming Showcase" : Model.Category!.Name)</span><span>@(Model.IsAbout ? "About this app" : Model.Example.HasValue ? $"Example {Model.Example.Value:00} of 05" : "5 example slots")</span></footer>
    </section>
}
